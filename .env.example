# GEMINI_API_KEY: Google AI Studio key (aistudio.google.com/apikey).
# When set, it takes precedence over OpenRouter for both listing and image
# generation. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Katalogit AI (server-side only) ──────────────────────────────────────
# These are read by server.ts / server/*.ts and are NEVER exposed to the
# browser bundle. Put the real values in .env.local (git-ignored).
#
# Text precedence: Gemini, then OpenRouter. Image editing tries Cloudflare
# FLUX.2 Klein first, then Gemini/OpenAI/OpenRouter if configured.

# Cloudflare Workers AI image editing. Use a Workers AI API token, not a Global
# API Key. Leave blank to disable Cloudflare. Values belong in ignored .env.local.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Gemini model ids (used when GEMINI_API_KEY is set). Defaults live in
# server/ai.ts; leave blank to accept the defaults.
GEMINI_TEXT_MODEL="gemini-3.5-flash-lite"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# OpenRouter API key, used only when no Gemini key is present.
OPENROUTER_API_KEY=""

# OpenRouter model ids. Defaults are set in server/ai.ts if these are blank.
OPENROUTER_TEXT_MODEL="google/gemini-2.5-flash"
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-lite-image"

# Optional OpenAI image editing. The uploaded source photo is sent as an image
# reference. If this key has no credit, the app tries Gemini/OpenRouter and
# finally creates a local studio finish that preserves the source photo.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"
OPENAI_IMAGE_QUALITY="low"
